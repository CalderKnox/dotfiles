{
  "$schema": "https://raw.githubusercontent.com/gotgenes/pi-packages/main/packages/pi-permission-system/schemas/permissions.schema.json",
  "yoloMode": false,
  "promptMaxRows": 8,
  "permission": {
    "*": "allow",
    "read": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "*.env.example": "allow",
      "~/.ssh/*": "deny",
      "~/.aws/*": "deny",
      "~/.gnupg/*": "deny"
    },
    "write": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "~/.ssh/*": "deny",
      "~/.aws/*": "deny",
      "~/.gnupg/*": "deny"
    },
    "edit": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "~/.ssh/*": "deny",
      "~/.aws/*": "deny",
      "~/.gnupg/*": "deny"
    },
    "bash": {
      "*": "allow",
      "sudo *": "deny",
      "mv *": "deny",
      "rm *": "deny",
      "unlink *": "deny",
      "dd *": "deny",
      "mkfs.*": "deny",
      "python3 *": "allow",
      "node *": "allow"
    },
    "path": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "*.env.example": "allow",
      "*.pem": "deny",
      "*.key": "deny",
      "~/.ssh/*": "deny",
      "~/.aws/*": "deny",
      "~/.gnupg/*": "deny",
      "/etc/*": "deny",
      "/var/*": "deny"
    },
    "external_directory": {
      "*": "ask",
      "~/.cargo/registry/*": "allow",
      "~/.npm/*": "allow",
      "~/.cache/*": "allow"
    }
  },
  "debugLog": false,
  "permissionReviewLog": true
}
