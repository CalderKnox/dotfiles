{
  "enabled": true,
  "shell": {
    "readAccess": "policy"
  },
  "filesystem": {
    "denyRead": [
      "/Users",
      "/home",
      "/root",
      "/etc",
      "/private/etc",
      "/var",
      "/private/var",
      "/private/tmp"
    ],
    "allowRead": [
      ".",
      "~/.gitconfig",
      "~/.gitignore_global",
      "~/.config/git/config",
      "/private/etc/ssl",
      "/dev/null",
      "~/.pi",
      "~/.agent"
    ],
    "allowWrite": [
      ".",
      "/dev/null",
      "/tmp",
      "~/.npm",
      "~/.cargo/registry",
      "~/.cache",
      "~/.config/git/config"
    ],
    "denyWrite": [
      "**/.env",
      "**/.env.*",
      "**/*.pem",
      "**/*.key",
      ".pi/sandbox.json",
      "~/.pi/agent/sandbox.json",
      "~/.ssh",
      "~/.bashrc",
      "~/.zshrc",
      "~/.profile",
      "~/.gitconfig",
      "**/.git"
    ]
  },
  "network": {
    "allowNetwork": true,
    "allowLocalBinding": true,
    "allowAllUnixSockets": true,
    "allowUnixSockets": [ ],
    "allowedDomains": [
      "github.com",
      "*.github.com",
      "*.githubusercontent.com"
    ],
    "deniedDomains": [ ]
  },
  "windows": {
    "appContainerMode": "standard",
    "allowLoopback": false
  }
}
