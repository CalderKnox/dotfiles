# =============================================================================
# private_config — SSH 客户端配置 (chezmoi: -> ~/.ssh/config, 0600)
# =============================================================================
# Description : OrbStack Include 置顶 + github.com 走 ssh.github.com:443 +
#               自适应 SOCKS5 ProxyCommand (7890 探活, 失败直连) + Host * 默认
# Usage       : `ssh -G dev` 排错, `ssh -T git@github.com` 测连通性
# Guards      : 0600 必需 (0644 被 ssh 拒绝), ProxyCommand bash -c 探活
# Author      : Payne
# =============================================================================
# SSH client config (chezmoi: private_dot_ssh/private_config -> ~/.ssh/config, 0600)
# `private_` prefix ensures 0600 permissions (required by ssh; 0644 is rejected).
# OrbStack Include must stay at top before any Host block to provide `orb` hosts.
# Added by OrbStack: 'orb' SSH host for Linux machines
# This only works if it's at the top of ssh_config (before any Host blocks).
# This won't be added again if you remove it.


# ssh -G dev              # 打印 dev 的最终生效配置（排错神器）
# ssh -vvv dev            # 详细调试输出，看认证/密钥过程
# ssh -T git@github.com   # 测试 Git SSH 连通性
# ssh -O check dev        # 检查复用连接是否存在
# ssh -O exit dev         # 关闭复用连接

Include ~/.orbstack/ssh/config

# server（模板占位：主机/密钥均为示例，按实际环境修改后再使用；
# ~/.ssh 下并无 id_rsa_dev/tst/ops/sec，直接连接会认证失败）
Host dev
  HostName 192.168.1.100
  User ubuntu
  Port 2222
  IdentityFile ~/.ssh/id_rsa_dev
  IdentitiesOnly yes

# 注意：tst/ops/sec 的 user@host:port 完全相同（ubuntu@192.168.1.101:2222），
# 使用固定安全前缀区分各自的 ControlPath，避免不同 IdentityFile 共用 master。
Host tst
  HostName 192.168.1.101
  User ubuntu
  Port 2222
  IdentityFile ~/.ssh/id_rsa_tst
  IdentitiesOnly yes
  ControlPath ~/.ssh/.cm-tst-%C

Host ops
  HostName 192.168.1.101
  User ubuntu
  Port 2222
  IdentityFile ~/.ssh/id_rsa_ops
  IdentitiesOnly yes
  ControlPath ~/.ssh/.cm-ops-%C

Host sec
  HostName 192.168.1.101
  User ubuntu
  Port 2222
  IdentityFile ~/.ssh/id_rsa_sec
  IdentitiesOnly yes
  ControlPath ~/.ssh/.cm-sec-%C

# jump server
# 直接 ssh inner 即可穿透跳板机。ProxyJump 支持多级：ProxyJump bastion,inner1
## 跳板机本身
# 示例占位（example.com 为保留域名），按实际跳板机环境修改后再使用
Host bastion
  HostName jump.example.com
  User jumpuser
  IdentityFile ~/.ssh/id_bastion

## 内网机器，通过 bastion 跳转（同属模板：id_inner 密钥缺省，需自备）
Host inner
  HostName 10.0.0.5
  User root
  IdentityFile ~/.ssh/id_inner
  ProxyJump bastion

# 多个git账号
# https://codeup.aliyun.com
Host codeup.aliyun.com
  HostName codeup.aliyun.com
  User git
  IdentitiesOnly yes
  PreferredAuthentications publickey
  IdentityFile ~/.ssh/id_ed25519_devops_aliyun

# Fixed prefixes keep the two same-endpoint GitHub aliases on separate sockets.
Host github.com
  ControlPath ~/.ssh/.cm-github-%C

Host ssh.github.com
  ControlPath ~/.ssh/.cm-ssh-github-%C

## private github
Host github.com ssh.github.com
  # ssh.github.com:443 — HTTPS port, traverses firewalls that block 22
  HostName ssh.github.com
  User git
  Port 443
  # Adaptive SOCKS5 proxy (127.0.0.1:7890): if the local proxy is listening, tunnel via SOCKS5;
  # otherwise fall back to a direct connection.
  ProxyCommand bash -c 'if nc -z 127.0.0.1 7890; then nc -X 5 -x 127.0.0.1:7890 %h %p; else nc %h %p; fi'


## github work（模板，当前未启用）
## 原块：HostName github.com + IdentitiesOnly yes 但未配 IdentityFile ——
## IdentitiesOnly 会禁用所有默认密钥，导致该主机实际上无法认证；且直连
## github.com:22 绕过了上面 github.com 块的 ssh.github.com:443 + SOCKS5 路由。
## 启用步骤：生成独立工作密钥（ssh-keygen -t ed25519 -f ~/.ssh/id_ed25519_work）、
## 加入 ssh-agent 并上传公钥后，取消下列整块注释：
## ControlPath 使用固定安全前缀，github-work.com 与 github.com 使用不同 socket。
# Host github-work.com
#     HostName ssh.github.com
#     User git
#     Port 443
#     IdentityFile ~/.ssh/id_ed25519_work
#     IdentitiesOnly yes
#     ControlPath ~/.ssh/.cm-github-work-%C
#     ProxyCommand bash -c 'if nc -z 127.0.0.1 7890; then nc -X 5 -x 127.0.0.1:7890 %h %p; else nc %h %p; fi'


# 对所有主机生效的默认配置（必须放最后）
Host *
  ServerAliveInterval 60
  ServerAliveCountMax 3
  StrictHostKeyChecking accept-new
  ControlMaster auto
  # Hash the connection tuple and keep sockets directly under private ~/.ssh.
  # Identity-sensitive aliases set a fixed safe prefix in their Host blocks above.
  ControlPath ~/.ssh/.cm-%C
  ControlPersist 600

