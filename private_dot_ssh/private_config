# =============================================================================
# private_config — SSH 客户端配置 (chezmoi: -> ~/.ssh/config, 0600)
# =============================================================================
# Description : OrbStack Include 置顶 + github.com 走 ssh.github.com:443 +
#               自适应 SOCKS5 ProxyCommand (5376 探活, 失败直连) + Host * 默认
# Usage       : `ssh -G dev` 排错, `ssh -T git@github.com` 测连通性
# Guards      : 0600 必需 (0644 被 ssh 拒绝), ProxyCommand bash -c 探活
# Author      : Payne
# =============================================================================
# SSH 客户端配置（chezmoi: private_dot_ssh/private_config -> ~/.ssh/config, 0600）
# `private_` 前缀确保部署后为 0600 权限（ssh 硬性要求；0644 会被拒绝）。
# OrbStack 的 Include 必须置于任何 Host 块之前，以提供 `orb` 主机。
# 由 OrbStack 添加：面向 Linux 机器的 'orb' SSH 主机
# 仅当位于 ssh_config 顶部（任何 Host 块之前）时才生效。
# 删除后 OrbStack 不会再次自动添加。


# ssh -G dev              # 打印 dev 的最终生效配置（排错神器）
# ssh -vvv dev            # 详细调试输出，看认证/密钥过程
# ssh -T git@github.com   # 测试 Git SSH 连通性
# ssh -O check dev        # 检查复用连接是否存在
# ssh -O exit dev         # 关闭复用连接

Include ~/.orbstack/ssh/config

# server（模板占位：主机/密钥均为示例，按实际环境修改后再使用；
# ~/.ssh 下并无 id_rsa_dev/tst/ops/sec，直接连接会认证失败）
Host dev
    HostName 192.168.1.100
    User ubuntu
    Port 2222
    IdentityFile ~/.ssh/id_rsa_dev
    IdentitiesOnly yes

# 注意：tst/ops/sec 的 user@host:port 完全相同（ubuntu@192.168.1.101:2222），
# 在 Host * ControlMaster auto + ControlPersist 600 下共享同一个复用 socket
# （ubuntu@192.168.1.101-2222，`ssh -O check` 可见）——首个连接的认证胜出，
# ops/sec 会静默复用该 master，各自的 IdentityFile 并不会生效。
# 切换身份：`ssh -O exit tst` 关闭复用连接，或 `ssh -o ControlPath=none ops` 直连。
Host tst
    HostName 192.168.1.101
    User ubuntu
    Port 2222
    IdentityFile ~/.ssh/id_rsa_tst
    IdentitiesOnly yes

Host ops
    HostName 192.168.1.101
    User ubuntu
    Port 2222
    IdentityFile ~/.ssh/id_rsa_ops
    IdentitiesOnly yes

Host sec
    HostName 192.168.1.101
    User ubuntu
    Port 2222
    IdentityFile ~/.ssh/id_rsa_sec
    IdentitiesOnly yes

# 跳板机
# 直接 ssh inner 即可穿透跳板机。ProxyJump 支持多级：ProxyJump bastion,inner1
## 跳板机本身
# 示例占位（example.com 为保留域名），按实际跳板机环境修改后再使用
Host bastion
    HostName jump.example.com
    User jumpuser
    IdentityFile ~/.ssh/id_bastion

## 内网机器，通过 bastion 跳转（同属模板：id_inner 密钥缺省，需自备）
Host inner
    HostName 10.0.0.5
    User root
    IdentityFile ~/.ssh/id_inner
    ProxyJump bastion

# 多个git账号


## 私人 GitHub
Host github.com ssh.github.com
    # ssh.github.com:443 —— HTTPS 端口，可穿越封锁 22 端口的防火墙
    HostName ssh.github.com
    User git
    Port 443
    # 自适应 SOCKS5 代理（127.0.0.1:5376）：本地代理在监听时经 SOCKS5 隧道；
    # 否则回退直连。
    ProxyCommand bash -c 'if nc -z 127.0.0.1 5376; then nc -X 5 -x 127.0.0.1:5376 %h %p; else nc %h %p; fi'


## github work（模板，当前未启用）
## 原块：HostName github.com + IdentitiesOnly yes 但未配 IdentityFile ——
## IdentitiesOnly 会禁用所有默认密钥，导致该主机实际上无法认证；且直连
## github.com:22 绕过了上面 github.com 块的 ssh.github.com:443 + SOCKS5 路由。
## 启用步骤：生成独立工作密钥（ssh-keygen -t ed25519 -f ~/.ssh/id_ed25519_work）、
## 加入 ssh-agent 并上传公钥后，取消下列整块注释：
## 注意：启用后 github-work.com 与 github.com 解析出相同的 ControlPath
## （git@ssh.github.com-443）——ControlPersist 600 窗口内会复用已有 master，
## 工作密钥永远不会被真正使用。连接前先 `ssh -O exit github.com` 关闭复用，
## 或用 `ssh -o ControlPath=none github-work.com` 直连，才能实际走工作身份。
# Host github-work.com ssh.github.com
#     HostName ssh.github.com
#     User git
#     Port 443
#     IdentityFile ~/.ssh/id_ed25519_work
#     IdentitiesOnly yes
#     ProxyCommand bash -c 'if nc -z 127.0.0.1 5376; then nc -X 5 -x 127.0.0.1:5376 %h %p; else nc %h %p; fi'


# 对所有主机生效的默认配置（必须放最后）
Host *
    ServerAliveInterval 60
    ServerAliveCountMax 3
    StrictHostKeyChecking accept-new
    ControlMaster auto
    # 目录由 chezmoi run_once 脚本创建（.chezmoiscripts/run_once_create-ssh-sockets.sh）
    ControlPath ~/.ssh/sockets/%r@%h-%p
    ControlPersist 600

