{
  "lastChangelogVersion": "1.2.0",
  "packages": [
    "npm:pi-subagents",
    "npm:pi-background-tasks",
    "npm:@quintinshaw/pi-dynamic-workflows",
    "npm:@czottmann/pi-automode",
    { "source": "npm:pi-web-access", "extensions": [ "-index.ts" ] },
    "npm:@narumitw/pi-goal",
    "npm:@narumitw/pi-btw",
    "npm:@narumitw/pi-statusline",
    "npm:@calesennett/pi-codex-fast",
    "npm:@piotr-oles/pi-reflag",
    "npm:pi-permission-modes"
  ],
  "defaultTools": [ "read", "bash", "edit", "write", "grep", "find", "ls" ],
  "defaultProvider": "openai",
  "defaultModel": "deepseek/deepseek-flash",
  "defaultThinkingLevel": "max",
  "steeringMode": "all",
  "hideThinkingBlock": true,
  "pi-codex-fast": { "enabled": true, "mode": "ultrafast" }
}
