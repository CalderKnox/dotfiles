# =============================================================================
# ~/.zshrc (chezmoi: dot_zshrc) —— 交互式 shell 主入口
# =============================================================================
# Description : Zim 框架安装块 + 个人环境初始化。结构：
#   ① PATH 收敛（~/bin、Homebrew、~/.local/bin 前置；~/.cargo & rustup 仅当
#      目录存在且 PATH 尚未包含时前置，重复 source 幂等）
#   ② 惰性初始化（zoxide/mise/starship 逐项 command -v 守卫；fzf 键位/补全
#      由 fzf.zsh 内带守卫地 eval 一次，唯一初始化点，避免双重加载）
#   ③ 外部配置 source（aliases → fzf → sdk，顺序即语义）
# Guards     : 所有工具初始化均 command -v 守卫，未装静默跳过；PATH 追加均带
#              目录存在性 + 去重双守卫（冒号定界 + typeset -U 去重）
# Loading-order contract: compinit(Zim) -> aliases.zsh -> fzf.zsh -> sdk.zsh
#   aliases 先于 fzf（后者 Ctrl-G 绑定在 source 时展开 $EDITOR）；
#   sdk 最后（其 compdef 注册依赖 compinit 完成）。
# Author     : Payne
# =============================================================================

# Start configuration added by Zim Framework install {{{
#
# User configuration sourced by interactive shells
#

# export LANG=en_US.UTF-8          # 注释备用项（默认已切 zh_CN.UTF-8，见下）
export LANG=zh_CN.UTF-8


# -----------------
# Zsh configuration
# -----------------

#
# History
#

# Remove older command from the history if a duplicate is to be added.
setopt HIST_IGNORE_ALL_DUPS

#
# Input/output
#

# Set editor default keymap to emacs (`-e`) or vi (`-v`)
bindkey -e

# Prompt for spelling correction of commands.
#setopt CORRECT

# Customize spelling correction prompt.
#SPROMPT='zsh: correct %F{red}%R%f to %F{green}%r%f [nyae]? '

# Remove path separator from WORDCHARS.
WORDCHARS=${WORDCHARS//[\/]}

# --------------------
# Module configuration
# --------------------

#
# git
#

# Set a custom prefix for the generated aliases. The default prefix is 'G'.
#zstyle ':zim:git' aliases-prefix 'g'

#
# input
#

# Append `../` to your input for each `.` you type after an initial `..`
#zstyle ':zim:input' double-dot-expand yes

#
# termtitle
#

# Set a custom terminal title format using prompt expansion escape sequences.
# See http://zsh.sourceforge.net/Doc/Release/Prompt-Expansion.html#Simple-Prompt-Escapes
# If none is provided, the default '%n@%m: %~' is used.
#zstyle ':zim:termtitle' format '%1~'

#
# zsh-autosuggestions
#

# Disable automatic widget re-binding on each precmd. Upstream suggests setting
# this when zsh-autosuggestions is the last ~/.zimrc module, which is the case
# here (fzf-tab initializes before the syntax-highlighting block), and the
# option cuts precmd cost.
ZSH_AUTOSUGGEST_MANUAL_REBIND=1

# Customize the style that the suggestions are shown with.
# See https://github.com/zsh-users/zsh-autosuggestions/blob/master/README.md#suggestion-highlight-style
#ZSH_AUTOSUGGEST_HIGHLIGHT_STYLE='fg=242'

# ------------------
# Initialize modules
# ------------------

ZIM_HOME=${ZDOTDIR:-${HOME}}/.zim
# Download zimfw plugin manager if missing or empty (zero-byte on prior failure).
# Robustness: curl → wget fallback, each checked for existence; failure cleans up
# zero-byte file and prints colored error, avoiding cryptic zimfw init failure.
if [[ ! -s ${ZIM_HOME}/zimfw.zsh ]]; then
  mkdir -p ${ZIM_HOME}
  if (( ${+commands[curl]} )); then
    if ! curl -fsSL --create-dirs -o ${ZIM_HOME}/zimfw.zsh \
        https://github.com/zimfw/zimfw/releases/latest/download/zimfw.zsh; then
      command rm -f -- ${ZIM_HOME}/zimfw.zsh
      print -P "%F{red}✗ zimfw download failed via curl%f" >&2
    fi
  elif (( ${+commands[wget]} )); then
    if ! wget -nv -O ${ZIM_HOME}/zimfw.zsh \
        https://github.com/zimfw/zimfw/releases/latest/download/zimfw.zsh; then
      command rm -f -- ${ZIM_HOME}/zimfw.zsh
      print -P "%F{red}✗ zimfw download failed via wget%f" >&2
    fi
  else
    print -P "%F{red}✗ curl and wget not found — cannot install zimfw%f" >&2
  fi
fi
# Install missing modules, and update ${ZIM_HOME}/init.zsh if missing or outdated.
# 守卫：下载失败（zimfw.zsh 缺失/空）时跳过 source，避免每次启动报错
if [[ ! ${ZIM_HOME}/init.zsh -nt ${ZIM_CONFIG_FILE:-${ZDOTDIR:-${HOME}}/.zimrc} ]]; then
  [[ -s ${ZIM_HOME}/zimfw.zsh ]] && source ${ZIM_HOME}/zimfw.zsh init
fi
# Initialize modules（init.zsh 尚未生成时跳过，待下次 zimfw 成功后再初始化）
[[ -s ${ZIM_HOME}/init.zsh ]] && source ${ZIM_HOME}/init.zsh
# }}} End configuration added by Zim Framework install



# PATH 去重：zsh 的 typeset -U 保证 path 数组唯一（自动去重，保留首次出现）
typeset -U path PATH
# PATH 收敛（逐目录冒号定界去重，避免粗粒度子串误判）。注意：逐项“前置”语义下
# 循环“最后”处理的目录最终优先级最高，故列表按目标优先级逆序书写——最终命中
# 顺序为 ~/bin > /opt/homebrew/bin|sbin > /usr/local/bin > ~/.local/bin
for _p in "$HOME/.local/bin" "/usr/local/bin" "/opt/homebrew/sbin" "/opt/homebrew/bin" "$HOME/bin"; do
  [[ -d "$_p" ]] && [[ ":$PATH:" != *":$_p:"* ]] && path=("$_p" $path)
done
unset _p

# init（逐项守卫：工具未安装时静默跳过，不再打印 command not found）
# 仅执行成功生成的完整初始化代码，避免失败的 producer 输出被 eval。
if command -v zoxide >/dev/null 2>&1 && _init="$(zoxide init zsh)"; then eval "$_init"; fi
if command -v mise >/dev/null 2>&1 && _init="$(mise activate zsh)"; then eval "$_init"; fi
if command -v starship >/dev/null 2>&1 && _init="$(starship init zsh)"; then eval "$_init"; fi
unset _init
# fzf 的键位绑定/补全不再在此 eval：统一由 fzf.zsh 内带守卫的
# `command -v fzf && eval "$(fzf --zsh)"` 初始化（唯一初始化点，避免双重加载）
# brew shellenv 也不再在此 eval：Zim 的 zimfw/homebrew 模块（见 dot_zimrc）
# 已在 init.zsh 阶段注入 HOMEBREW_PREFIX 等环境（早于下方 rustup 守卫），
# 重复 eval 非幂等且多一次子进程开销
# rustup 工具链 PATH：静态路径替代 `brew --prefix rustup` 子进程调用（省一次启动子进程，
# 且 rustup 卸载后不再报错）；目录守卫避免注入死路径，去重守卫（冒号定界）避免重复 source 时累积
[[ -d "$HOME/.cargo/bin" && ":$PATH:" != *":$HOME/.cargo/bin:"* ]] && path=("$HOME/.cargo/bin" $path)
[[ -d "${HOMEBREW_PREFIX:-/opt/homebrew}/opt/rustup/bin" && ":$PATH:" != *":${HOMEBREW_PREFIX:-/opt/homebrew}/opt/rustup/bin:"* ]] && path=("${HOMEBREW_PREFIX:-/opt/homebrew}/opt/rustup/bin" $path)

# ---------------------------------------------------------------------------
# 外部配置加载（Loading-order contract：aliases → fzf → sdk，顺序即语义）
# - 显式逐个 source（不用 glob）：新掉 .zsh 文件不会静默改变加载集，
#   模块顺序是文档化契约，必须在这里看得见
# - 守卫：PATH 插入均目录存在+去重；工具 init 均 command -v 守卫
# ---------------------------------------------------------------------------
[[ -f "$HOME/.config/zsh/aliases.zsh" ]] && source "$HOME/.config/zsh/aliases.zsh"
[[ -f "$HOME/.config/zsh/fzf.zsh" ]] && source "$HOME/.config/zsh/fzf.zsh"
[[ -f "$HOME/.config/zsh/sdk.zsh" ]] && source "$HOME/.config/zsh/sdk.zsh"
