# ============================================
# Ghostty Terminal - Complete Configuration (chezmoi: private_dot_config/ghostty/config -> ~/.config/ghostty/config, dir 0700)
# Theme/palette: Catppuccin Mocha (dark) — see "Theme and Colors" section.
# ============================================
# File: ~/.config/ghostty/config
# Reload: Cmd+Shift+, (macOS)
# View options: ghostty +show-config --default --docs

env = LANG=zh_CN.UTF-8

# command = /bin/zsh -l
command = /opt/homebrew/bin/fish -l
# command = /opt/homebrew/bin/tmux new -As main

#--- Typography ---
font-family = "JetBrainsMono Nerd Font Mono"
font-feature = "+calt"
font-size = 16

# 精细调整字重与渲染（macOS 独有优化）
font-thicken = true
alpha-blending = linear 

# 微调字符间距（-1 到 2 之间，依字体而定）
adjust-cell-width = -1
adjust-cell-height = 2

# --- Theme and Colors ---
# Palette/theme: Catppuccin Mocha (dark). The macOS window chrome follows the
# system appearance via `window-theme = auto` (set further below).
theme = Catppuccin Mocha
# Alternative palettes (uncomment to switch):
# theme = Dracula+
# theme = "Warm Neon"

# --- Window and Appearance ---
# # 背景透明度：微妙的毛玻璃效果（0.85-0.95 之间最优雅）
background-opacity = 0.92
background-blur-radius = 20

# # 窗口边距：呼吸感的关键，避免文字贴边
window-padding-x = 12
window-padding-y = 12
window-padding-balance = true

window-width = 0
window-height = 0

window-save-state = always
window-theme = auto

window-decoration = true

# 移除多余装饰（macOS）
macos-titlebar-proxy-icon = hidden

# --- Cursor ---
# cursor-style = underline
cursor-style = block
cursor-style-blink = true
cursor-opacity = 0.8
# adjust-cursor-thickness = 2px

mouse-scroll-multiplier = 1.0

# 工作目录继承，保持上下文连贯
working-directory = ~/workspaces
window-inherit-working-directory = true
window-inherit-font-size = true

# --- Mouse ---
# 输入时自动隐藏鼠标指针
mouse-hide-while-typing = true
clipboard-read = allow
clipboard-write = allow
copy-on-select = clipboard

# --- Quick Terminal (Quake-style dropdown) ---
# 注意：quick-terminal-screen / animation-duration 统一在文件末尾赋值（历史重复键已去重）
quick-terminal-position = top
quick-terminal-autohide = true

# --- Security ---
clipboard-paste-protection = true
clipboard-paste-bracketed-safe = true
clipboard-trim-trailing-spaces = true

# --- Shell Integration ---
# shell-integration = detect
shell-integration-features = no-cursor


# --- Keybindings ---
# Tabs: Cmd+T new, Cmd+Shift+Arrow prev/next, Cmd+W close
keybind = cmd+t=new_tab
keybind = cmd+shift+left=previous_tab
keybind = cmd+shift+right=next_tab
keybind = cmd+w=close_surface

# Splits: Cmd+D right, Cmd+Shift+D down, Cmd+Alt+Arrows navigate
keybind = cmd+d=new_split:right
keybind = cmd+shift+d=new_split:down
keybind = cmd+alt+left=goto_split:left
keybind = cmd+alt+right=goto_split:right
keybind = cmd+alt+up=goto_split:top
keybind = cmd+alt+down=goto_split:bottom


macos-option-as-alt = right
# macos-option-as-alt = true  # alternative: both Options as Alt

# Font size: Cmd+Plus/Minus/Zero
keybind = cmd+plus=increase_font_size:1
keybind = cmd+minus=decrease_font_size:1
keybind = cmd+zero=reset_font_size

# Quick terminal global hotkey (Ctrl+` toggles dropdown)
keybind = global:ctrl+grave_accent=toggle_quick_terminal

# Splits management: equalize / zoom
keybind = cmd+shift+e=equalize_splits
keybind = cmd+shift+f=toggle_split_zoom

# Reload config
# keybind = cmd+shift+comma=reload_config

# --- Performance ---
# Generous scrollback (64MB) 1024 * 1024 * 64
# scrollback-limit = 67108864

# 图像内存限制（防止 Kitty Graphics Protocol 图像占用过多 GPU 内存）256MB，适合 16GB 内存机型
# image-storage-limit = 268435456


# GTK 单实例模式（Linux 性能关键）
# gtk-single-instance = true
# 关闭退出前确认提示；滚动缓冲并非无限，见上方 scrollback-limit（64MB）
# confirm-close-surface = false


# Quick Terminal 生效值（历史重复键已去重，按末次赋值保留，行为不变）
# quick-terminal-screen = main
# quick-terminal-animation-duration = 0.15

# 启用自动更新检查但异步进行，不阻塞启动
# auto-update = check
# auto-update-channel = stable

# macOS 特有的单实例模式优化
## 减少 Core Animation 开销
# macos-window-shadow = false

# 禁用调整大小时的浮层提示（更干净）
resize-overlay = never

# quit-after-last-window-closed = true

