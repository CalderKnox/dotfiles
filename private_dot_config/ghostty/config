# ============================================
# Ghostty 终端 - 完整配置 (chezmoi: private_dot_config/ghostty/config -> ~/.config/ghostty/config, 目录 0700)
# 主题/配色：Catppuccin Mocha（深色）——见「主题与颜色」一节。
# ============================================
# 文件: ~/.config/ghostty/config
# 重载: Cmd+Shift+,（macOS）
# 查看生效值: ghostty +show-config --default --docs

env = LANG=zh_CN.UTF-8

# command = /bin/zsh -l
command = /opt/homebrew/bin/fish -l
# command = /opt/homebrew/bin/tmux new -As main

#--- 字体排版 ---
font-family = "JetBrainsMono Nerd Font Mono"
font-feature = "+calt"
font-size = 15

# 精细调整字重与渲染（macOS 独有优化）
font-thicken = true
alpha-blending = linear 

# 微调字符间距（-1 到 2 之间，依字体而定）
adjust-cell-width = -1
adjust-cell-height = 2

# --- 主题与颜色 ---
# 配色/主题：Catppuccin Mocha（深色）。macOS 窗口外观经下方的
# `window-theme = auto` 跟随系统外观。
theme = Catppuccin Mocha
# 备选配色（取消注释即切换）：
# theme = Dracula+
# theme = "Warm Neon"

# --- 窗口与外观 ---
# # 背景透明度：微妙的毛玻璃效果（0.85-0.95 之间最优雅）
background-opacity = 0.92
background-blur-radius = 20

# # 窗口边距：呼吸感的关键，避免文字贴边
window-padding-x = 12
window-padding-y = 12
window-padding-balance = true

window-width = 0
window-height = 0

window-save-state = always
window-theme = auto

window-decoration = true

# 移除多余装饰（macOS）
macos-titlebar-proxy-icon = hidden

# --- 光标 ---
# cursor-style = underline
cursor-style = block
cursor-style-blink = true
cursor-opacity = 0.8
# adjust-cursor-thickness = 2px

mouse-scroll-multiplier = 1.0

# 工作目录继承，保持上下文连贯
working-directory = ~/workspaces
window-inherit-working-directory = true
window-inherit-font-size = true

# --- 鼠标 ---
# 输入时自动隐藏鼠标指针
mouse-hide-while-typing = true
clipboard-read = allow
clipboard-write = allow
copy-on-select = clipboard

# --- Quick Terminal（Quake 风格下拉终端） ---
# 注意：quick-terminal-screen / animation-duration 统一在文件末尾赋值（历史重复键已去重）
quick-terminal-position = top
quick-terminal-autohide = true

# --- 安全 ---
clipboard-paste-protection = true
clipboard-paste-bracketed-safe = true
clipboard-trim-trailing-spaces = true

# --- Shell 集成 ---
# shell-integration = detect
shell-integration-features = no-cursor


# --- 键位绑定 ---
# 标签页: Cmd+T 新建, Cmd+Shift+方向键 前后切换, Cmd+W 关闭
keybind = cmd+t=new_tab
keybind = cmd+shift+left=previous_tab
keybind = cmd+shift+right=next_tab
keybind = cmd+w=close_surface

# 分屏: Cmd+D 右侧, Cmd+Shift+D 下方, Cmd+Alt+方向键 导航
keybind = cmd+d=new_split:right
keybind = cmd+shift+d=new_split:down
keybind = cmd+alt+left=goto_split:left
keybind = cmd+alt+right=goto_split:right
keybind = cmd+alt+up=goto_split:top
keybind = cmd+alt+down=goto_split:bottom


macos-option-as-alt = right
# macos-option-as-alt = true  # 备选: 两侧 Option 均作 Alt

# 字号: Cmd+加号/减号/零
keybind = cmd+plus=increase_font_size:1
keybind = cmd+minus=decrease_font_size:1
keybind = cmd+zero=reset_font_size

# Quick Terminal 全局热键（Ctrl+` 切换下拉）
keybind = global:ctrl+grave_accent=toggle_quick_terminal

# 分屏管理: 均分 / 缩放
keybind = cmd+shift+e=equalize_splits
keybind = cmd+shift+f=toggle_split_zoom

# 重载配置
# keybind = cmd+shift+comma=reload_config

# --- 性能 ---
# 大回滚缓冲 (64MB) 1024 * 1024 * 64
scrollback-limit = 67108864

# 图像内存限制（防止 Kitty Graphics Protocol 图像占用过多 GPU 内存）256MB，适合 16GB 内存机型
image-storage-limit = 268435456


# GTK 单实例模式（Linux 性能关键）
gtk-single-instance = true
# 关闭退出前确认提示；滚动缓冲并非无限，见上方 scrollback-limit（64MB）
confirm-close-surface = false


# Quick Terminal 生效值（历史重复键已去重，按末次赋值保留，行为不变）
quick-terminal-screen = main
quick-terminal-animation-duration = 0.15

# 启用自动更新检查但异步进行，不阻塞启动
auto-update = check
auto-update-channel = stable

# macOS 特有的单实例模式优化
## 减少 Core Animation 开销
macos-window-shadow = false

# 禁用调整大小时的浮层提示（更干净）
resize-overlay = never

quit-after-last-window-closed = true
