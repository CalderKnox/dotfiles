# Git 配置（chezmoi: dot_gitconfig -> ~/.gitconfig）
# 核心 / LFS / safe 设置；`core.excludesfile` 见 dot_gitignore_global。
# 代理：见下方 [http "https://github.com"] 旁的 NOTE（单一事实来源）。

[core]
	# git config 仅将双引号视为引用；单引号是字面字符（旧值 'code' 靠 sh 启动编辑器剥离引号才可用），
	# 规范为不带引号的裸值，行为一致
	editor = code --wait
	autocrlf = input
	excludesfile = ~/.gitignore_global
[filter "lfs"]
	# Git LFS —— 大文件 smudge/clean 必须保持 required = true；经 `git lfs install` 安装。
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true
	clean = git-lfs clean -- %f

[user]
	name = azwpayne
	email = paynewu0719@gmail.com
[init]
	defaultBranch = main

# NOTE: GitHub HTTPS 仅有此代理 socks5h://127.0.0.1:5376，代理离线时无直连回退；
# 临时恢复直连：git config --global --unset http.https://github.com.proxy
[http "https://github.com"]
	proxy = socks5h://127.0.0.1:5376
[push]
	default = current
	autoSetupRemote = true
[safe]
	# `*` 表示任意目录均视为安全（OrbStack/Docker/sudo 属主仓库所需）。
	# 如需更严格校验，可收紧为显式路径（如 `/work/*`）。
	directory = *
