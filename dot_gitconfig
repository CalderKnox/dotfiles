# Git configuration (chezmoi: dot_gitconfig -> ~/.gitconfig)
# Core / LFS / safe settings. See dot_gitignore_global for `core.excludesfile`.
# Proxy: see NOTE next to [http "https://github.com"] below (single source of truth).

[core]
	# git config 仅将双引号视为引用；单引号是字面字符（旧值 'code' 靠 sh 启动编辑器剥离引号才可用），
	# 规范为不带引号的裸值，行为一致
	editor = code --wait
	autocrlf = input
	excludesfile = ~/.gitignore_global

[filter "lfs"]
	# Git LFS — keep required for large-file smudge/clean; installed via `git lfs install`.
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true
	clean = git-lfs clean -- %f

[user]
	name = azwpayne
	email = paynewu0719@gmail.com

[init]
	defaultBranch = main

# NOTE: GitHub HTTPS 仅有此代理 socks5h://127.0.0.1:5376，代理离线时无直连回退；
# 临时恢复直连：git config --global --unset http.https://github.com.proxy
[http "https://github.com"]
	proxy = socks5h://127.0.0.1:5376

[push]
	default = current
	autoSetupRemote = true

[safe]
	# 安全审计收紧：原通配符写法会把任意目录标记为安全（任何被篡改/可疑的仓库
	# 都能绕过 git 的 ownership 检查），风险过大；现改为仅显式信任 chezmoi 仓库目录。
	# 如 OrbStack/Docker/sudo 场景再报 dubious ownership，请按需逐条追加显式路径。
	directory = ~/.local/share/chezmoi
