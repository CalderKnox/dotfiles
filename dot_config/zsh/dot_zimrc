# =============================================================================
# ~/.zimrc (chezmoi: dot_zimrc) —— Zim 框架模块清单
# =============================================================================
# Description : 仅供 zimfw 读取以生成 ~/.zim/init.zsh；shell 启动时不 source。
#               分类：基础环境 / 提示符 / 补全 / 末尾模块（语法高亮、历史搜索、
#               自动建议）。注释掉的模块（fzf / zsh-syntax-highlighting / zfm）
#               未加载，由 fzf.zsh 与 fast-syntax-highlighting 等替代。
# Author      : Payne
# zimfw docs  : https://github.com/zimfw/zimfw
# Update      : `zimfw install` 重新生成 ~/.zim/init.zsh；新增模块放 utility 之后、
#               Prompt 之前（见下方注释）。
# =============================================================================

#
# This is not sourced during shell startup and is only used to configure zimfw.
#

#
# Modules
#

# Sets sane Zsh built-in environment options.
zmodule environment
# Provides handy git aliases and functions.
zmodule git
# Applies correct bindkeys for input events. Add one of the following to the
# beginning of your ~/.zshrc to set your preferred editor keymap to emacs or vi
# respectively: bindkey -e or bindkey -v
zmodule input
# Sets a custom terminal title.
zmodule termtitle
# Utility aliases and functions. Adds colour to ls, grep and less.
zmodule utility

# <-- Normally new modules should be added here. Check each module documentation
# for any caveats.

#
# Prompt
#

# Exposes how long the last command took to run to prompts.
zmodule duration-info
# Exposes git repository status information to prompts.
zmodule git-info
# Formats the current working directory for prompts.
zmodule prompt-pwd
# A heavily reduced, ASCII-only version of the Spaceship and Starship prompts.
zmodule asciiship

#
# Completion
#
# Homebrew：注入 brew shellenv（HOMEBREW_PREFIX/PATH/fpath 等）并提供 brew/cask 别名。
# fpath 无需额外声明：shell 启动时 HOMEBREW_PREFIX 未设，模块 else 分支 eval 的
# brew shellenv 会无条件前置 brew 的 site-functions（fpath[1,0]），补全直接可用。
zmodule zimfw/homebrew

# Additional completion definitions for Zsh.
zmodule zsh-users/zsh-completions --fpath src
# Enables and configures smart and extensive tab completion, must be sourced
# after all modules that add completion definitions.
zmodule completion

# <!-- zmodule fzf -->  # disabled: replaced by Aloxaf/fzf-tab + fzf.zsh
# fzf-tab: replace Zsh's default completion menu with fzf-powered fuzzy search.
zmodule Aloxaf/fzf-tab

#
# Modules that must be initialized last
#

# Fish-like syntax highlighting for Zsh, must be sourced after completion.
# <!-- zmodule zsh-users/zsh-syntax-highlighting -->  # disabled: using fast-syntax-highlighting
zmodule zdharma-continuum/fast-syntax-highlighting
# Fish-like history search for Zsh, must be sourced after
# fast-syntax-highlighting.
zmodule zsh-users/zsh-history-substring-search
# Fish-like autosuggestions for Zsh. Add the following to your ~/.zshrc to boost
# performance: ZSH_AUTOSUGGEST_MANUAL_REBIND=1
zmodule zsh-users/zsh-autosuggestions

# <!-- zmodule pabloariasal/zfm -->  # disabled: file-manager not needed

