# Ghostty Terminal (macOS)
# Chezmoi: dot_config/ghostty/config -> ~/.config/ghostty/config
# Reload: Cmd+Shift+, (macOS)
# View options: ghostty +show-config --default --docs

# --- Shell and Working Directory ---
env = LANG=zh_CN.UTF-8

# 直接启动 fish 登录 shell，省去 /bin/sh 的参数展开步骤。
command = direct:/opt/homebrew/bin/fish -l

# 工作目录继承，保持上下文连贯
working-directory = ~/workspaces
window-inherit-working-directory = true
window-inherit-font-size = true

# 保持自定义光标样式，其余 shell 集成功能使用默认值。
shell-integration-features = no-cursor

# --- Typography ---
font-family = "JetBrainsMonoNL Nerd Font Mono"
font-size = 16

# 使用自然字重，避免线性混合使浅色文字显得过厚。
font-thicken = false
alpha-blending = linear-corrected

# 保持字体原始字宽，增加行高以改善阅读。
adjust-cell-height = 2

# --- Theme and Colors ---
# Catppuccin Mocha (dark). `window-theme = auto` derives the window theme
# from the terminal background rather than the system appearance.
theme = Catppuccin Mocha

# --- Window and Appearance ---
# 背景透明度与模糊
background-opacity = 0.92
background-blur = 20

# 窗口边距，避免文字贴边
window-padding-x = 12
window-padding-y = 12
window-padding-balance = true

window-save-state = always
window-theme = auto

window-decoration = auto

# 移除多余装饰（macOS）
macos-titlebar-proxy-icon = hidden

# 禁用调整大小时的浮层提示
resize-overlay = never

# --- Cursor ---
cursor-style = block
cursor-style-blink = true
cursor-opacity = 0.8

# --- Mouse ---
# 输入时自动隐藏鼠标指针
mouse-hide-while-typing = true
mouse-scroll-multiplier = 1.0

# --- Clipboard ---
clipboard-read = allow
clipboard-write = allow
copy-on-select = clipboard

clipboard-paste-protection = true
clipboard-paste-bracketed-safe = true
clipboard-trim-trailing-spaces = true

# --- Quick Terminal (Quake-style dropdown) ---
quick-terminal-position = top
quick-terminal-autohide = true
quick-terminal-animation-duration = 0.12

# --- Keybindings ---
# Tabs: Cmd+T new, Cmd+Shift+Arrow prev/next, Cmd+W close
keybind = cmd+t=new_tab
keybind = cmd+shift+left=previous_tab
keybind = cmd+shift+right=next_tab
keybind = cmd+w=close_surface

# Splits: Cmd+D right, Cmd+Shift+D down, Cmd+Alt+Arrows navigate
keybind = cmd+d=new_split:right
keybind = cmd+shift+d=new_split:down
keybind = cmd+alt+left=goto_split:left
keybind = cmd+alt+right=goto_split:right
keybind = cmd+alt+up=goto_split:top
keybind = cmd+alt+down=goto_split:bottom

macos-option-as-alt = right

# Font size: Cmd+Plus/Minus/Zero
keybind = cmd+plus=increase_font_size:1
keybind = cmd+minus=decrease_font_size:1
keybind = cmd+zero=reset_font_size

# Quick terminal global hotkey (Ctrl+` toggles dropdown)
keybind = global:ctrl+grave_accent=toggle_quick_terminal

# Splits management: equalize / zoom; use Esc to exit search.
keybind = cmd+shift+e=equalize_splits
keybind = cmd+shift+f=toggle_split_zoom

# Reload: Cmd+Shift+, is a default binding.

# --- Memory Budgets ---
# 保持 Ghostty 1.3.1 的默认滚动缓冲预算：每个终端 surface 10,000,000 字节，
# 包含当前屏幕，按需分配。重新加载后仅对新 surface 生效。
scrollback-limit = 10000000

# Kitty 图像数据预算：每个屏幕 256 MiB（不是进程/GPU 总内存上限）。
# 主屏幕与备用屏幕分别计算，每个终端 surface 合计最多 512 MiB。
image-storage-limit = 268435456
